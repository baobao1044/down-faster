{
  "name": "down-faster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tr\u00ecnh t\u0103ng t\u1ed1c t\u1ea3i \u0111a lu\u1ed3ng d\u1ea1ng extension cho Chromium v\u00e0 Firefox",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baobao1044/down-faster.git"
  },
  "bugs": {
    "url": "https://github.com/baobao1044/down-faster/issues"
  },
  "homepage": "https://github.com/baobao1044/down-faster#readme",
  "keywords": [
    "download-manager",
    "download-accelerator",
    "browser-extension",
    "manifest-v3",
    "chromium",
    "firefox",
    "http-range",
    "multi-connection",
    "opfs",
    "hls",
    "typescript"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target=chromium",
    "build:firefox": "node scripts/build.mjs --target=firefox",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node scripts/test.mjs",
    "testserver": "node scripts/testserver.mjs",
    "verify": "node scripts/verify.mjs",
    "make-icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/bench.mjs",
    "e2e": "node scripts/e2e/run.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^25.3.2",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.58.2",
    "typescript": "^5.7.0"
  }
}
